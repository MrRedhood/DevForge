{
  "name": "devforge-marketplace-api",
  "private": true,
  "version": "1.0.0",
  "description": "Cloudflare Workers API for the DevForge first-party Marketplace.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute devforge-marketplace --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute devforge-marketplace --remote --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.102.0"
  }
}
